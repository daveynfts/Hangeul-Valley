# Copy to .env.local (gitignored). Same R2_* as KOL Radar / daveynfts Vercel.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://cdn.daveynfts.com/hangeul-valley

# Vercel Deploy Hook (Project → Settings → Git → Deploy Hooks).
# POST after R2 is live so prod JS does not boot against stale CDN content.
VERCEL_DEPLOY_HOOK_URL=

# Google Identity Services — Web client ID (not the secret).
# Authorized JS origins: the Vercel URL, any custom domain, and http://localhost:8742
GOOGLE_CLIENT_ID=

# Signs the game's own 30-day sign-in cookie (api/_session.js). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it /api/session answers 501 and the game falls back to sending the Google ID
# token on every save — which works, and expires after an hour, which is the problem.
# Changing it signs everybody out; it is never sent to the browser.
SESSION_SECRET=
