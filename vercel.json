{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "_comment": "api/admin-host.js was folded into the single admin function to stay under the twelve-function ceiling. The old URL is what admin/public/js/app.js asks for, so it is kept as a rewrite rather than broken.",
      "source": "/api/admin-host",
      "destination": "/api/admin/host"
    },
    {
      "source": "/admin/",
      "destination": "/admin/public/index.html"
    },
    {
      "source": "/admin/css/:path*",
      "destination": "/admin/public/css/:path*"
    },
    {
      "source": "/admin/js/:path*",
      "destination": "/admin/public/js/:path*"
    },
    {
      "source": "/sprite-preview/:path*",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/sprites/:path*"
    },
    {
      "source": "/levels.json",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/levels.json"
    },
    {
      "source": "/facts.json",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/facts.json"
    },
    {
      "source": "/worlds/:path*",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/worlds/:path*"
    },
    {
      "source": "/sprites/:path*",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/sprites/:path*"
    },
    {
      "source": "/skins/:path*",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/skins/:path*"
    },
    {
      "source": "/audio/:path*",
      "destination": "https://cdn.daveynfts.com/hangeul-valley/audio/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sprites/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sprites/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/(levels|facts).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/worlds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/skins/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "functions": {
    "api/art.js": {
      "includeFiles": "sprites/**"
    },
    "api/stats.js": {
      "includeFiles": "{levels.json,facts.json}"
    },
    "api/levels.js": {
      "includeFiles": "levels.json"
    },
    "api/levels/[num].js": {
      "includeFiles": "levels.json"
    },
    "api/vocab-facts.js": {
      "includeFiles": "{levels.json,facts.json}"
    },
    "api/unit10/[kind].js": {
      "includeFiles": "worlds/**"
    },
    "api/skins/catalog.js": {
      "includeFiles": "skins/catalog.json"
    }
  }
}

